{
  "name": "playwright-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Tony's Pizza: a tiny app for learning Playwright and Playwright MCP",
  "scripts": {
    "start": "serve app -l 3000",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "screenshots": "playwright test proposal-screenshots --project=chromium",
    "visual:update": "playwright test superpowers --project=chromium --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "serve": "^14.2.6"
  }
}
